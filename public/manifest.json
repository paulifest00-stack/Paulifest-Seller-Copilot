{
  "manifest_version": 3,
  "name": "Paulifest Seller Copilot",
  "version": "1.0.0",
  "description": "Assistente Inteligente para Sellers no Bling ERP e Mercado Livre.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Paulifest Seller Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.bling.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*",
        "*://*.bling.com.br/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
